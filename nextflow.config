manifest {
    name        = 'bacflow'
    version     = '1.2.0'
    description = 'Long-Read Genome Assembly Pipeline'
    author      = 'jlpitta'
    nextflowVersion = '>=23.04.0'
}

params {
    // Input
    samplesheet     = null
    long_reads      = null
    short_reads_1   = null
    short_reads_2   = null
    sample_name     = 'sample'
    genome_size     = null

    // Mode
    mode            = 'denovo'

    // Polishing
    use_racon         = false
    polisher          = 'polypolish'  // polypolish (default), nextpolish, none
    nextpolish_rounds = 1             // apenas para --polisher nextpolish

    // Platform
    platform        = 'mgicyclone'
    medaka_model    = null   // definido pelo platform; sobrescreve com --medaka_model
    flye_mode       = null   // definido pelo platform; sobrescreve com --flye_mode

    // Filtering
    min_quality     = 10
    min_length      = 500
    downsample      = 0

    // Reference
    reference       = null

    // QC de montagem (BUSCO — só roda quando reference == null)
    busco_lineage   = 'bacteria_odb10'

    // QC de montagem (CheckM2 — completude + contaminação, roda sempre)
    checkm2_db      = "${System.getenv('HOME')}/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"

    // Anotação (Bakta — roda sempre, na montagem final)
    bakta_db        = "${System.getenv('HOME')}/bakta_db/db"

    // Taxonomia (GTDB-Tk — roda sempre, na montagem final)
    // O nome da pasta muda por release (ex: release232). Ao atualizar o banco,
    // mude AQUI e a variável GTDBTK_RELEASE do download_databases.sh juntas —
    // os dois precisam apontar pro mesmo release, senão o pipeline não acha o DB.
    gtdbtk_db       = "${System.getenv('HOME')}/gtdbtk_db/release232"

    // AMR (AMRFinderPlus — roda sempre, na montagem final; banco próprio,
    // independente do embutido no Bakta)
    amrfinder_db    = "${System.getenv('HOME')}/amrfinder_db/latest"

    // Resources
    t               = 8    // teto de CPUs do executor (quanto esse run pode usar no total)
    // cpus por task, fixos e independentes de --t (ver comentário no bloco
    // `process` abaixo pro porquê) -- sobrescreva com --cpus_high etc. se
    // precisar de tasks maiores/menores que o default.
    cpus_low        = 2    // ex.: FastQC, NanoStat, AMRFinderPlus
    cpus_medium     = 8    // ex.: Bakta, GTDB-Tk, CheckM2
    cpus_high       = 16   // ex.: Flye, Unicycler, Medaka, Polypolish/NextPolish
    outdir          = 'results'

    // Executor de cluster (profiles `pbs`/`slurm`) -- null = usa o default
    // da fila/partição do cluster
    pbs_queue         = null
    pbs_queue_size    = 50
    slurm_partition   = null
    slurm_queue_size  = 50

    // Help
    help            = false
}

conda.enabled  = true
conda.useMamba = true

// Trace de execução -- usado pelo generate_dashboard.py pra listar, na seção
// "Assemblies not completed", quais amostras tiveram alguma task com
// errorStrategy 'ignore' de fato descartada (nome do processo + exit code +
// workdir), já que essas tasks hoje somem sem deixar rastro nenhum.
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,submit,duration,realtime,workdir'
}

executor {
    name = 'local'
    cpus = Math.min(params.t as int, Runtime.runtime.availableProcessors())
}

process {
    cache = 'lenient'

    // Cpus por processo FIXOS, não escalados a partir de --t: antes
    // process_high pedia o --t inteiro (ex. --t 80), então uma única task
    // pesada (Unicycler) tomava o budget do executor sozinha e serializava
    // o lote inteiro -- nenhuma outra task rodava em paralelo com ela. Com
    // um valor fixo por task, várias tasks process_high cabem ao mesmo tempo
    // dentro do teto de --t (ex.: --t 80 / cpus_high 16 = até 5 em paralelo).
    //
    // Clampado tanto pelo teto real da máquina quanto por --t: uma única
    // task nunca pode pedir mais cpus do que o teto do PRÓPRIO executor
    // (params.t), senão o Nextflow recusa a task inteira com "Process
    // requirement exceeds available CPUs" -- ex.: cpus_high=16 (default) com
    // --t 4 (smoke test) precisa cair pra 4, não travar.
    withLabel: 'process_low' {
        cpus = { Math.max(1, [params.cpus_low as int, params.t as int, Runtime.runtime.availableProcessors()].min()) }
    }
    withLabel: 'process_medium' {
        cpus = { Math.max(1, [params.cpus_medium as int, params.t as int, Runtime.runtime.availableProcessors()].min()) }
    }
    withLabel: 'process_high' {
        cpus = { Math.max(1, [params.cpus_high as int, params.t as int, Runtime.runtime.availableProcessors()].min()) }
    }
}

profiles {
    conda      { conda.useMamba = false }
    mamba      { /* default */ }
    micromamba { conda.mambaBin = 'micromamba' }

    // Executor nativo do Nextflow pra cluster PBS Professional/OpenPBS --
    // Nextflow passa a submeter 1 job PBS por task, em vez do wrapper manual
    // de hoje (1 job PBS único chamando `nextflow run` com executor local
    // dentro, usado no batch Áurea Inova). Ajuste pbs_queue/pbs_queue_size
    // pro cluster real (--pbs_queue workq, por exemplo).
    pbs {
        process.executor     = 'pbspro'
        process.queue        = params.pbs_queue ?: 'workq'
        executor.queueSize   = params.pbs_queue_size as int
        executor.pollInterval = '30 sec'
    }

    slurm {
        process.executor     = 'slurm'
        process.queue        = params.slurm_partition ?: 'batch'
        executor.queueSize   = params.slurm_queue_size as int
        executor.pollInterval = '30 sec'
    }
}
